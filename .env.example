# Database connection untuk PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/stockfolio?schema=public"

# GoAPI Saham Indonesia
# Dapatkan API key gratis di https://goapi.io/
GOAPI_KEY="your_goapi_key_here"

# GNews API untuk berita investasi (opsional)
# Dapatkan API key di https://gnews.io/
GNEWS_API_KEY="your_gnews_api_key_here"
